{
  "name": "aedriain",
  "version": "0.3.1",
  "private": true,
  "description": "Webcam-controlled holographic spatial desktop for files, documents, schedules, maps, tasks, notes, settings, and AI.",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "bootstrap": "node scripts/bootstrap-project.mjs",
    "doctor": "node scripts/verify-install.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "predev": "npm run verify:install",
    "dev": "vite",
    "prebuild": "npm run verify:install",
    "build": "npm run verify:assets && tsc -b && vite build",
    "preview": "vite preview",
    "predesktop:dev": "npm run verify:install",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop": "electron .",
    "typecheck": "tsc -b --pretty false",
    "assets:mediapipe": "node scripts/vendor-mediapipe.mjs",
    "assets:pdfjs": "node scripts/vendor-pdfjs.mjs",
    "setup": "npm run assets:mediapipe && npm run assets:pdfjs",
    "verify:assets": "node scripts/verify-mediapipe-assets.mjs && node scripts/verify-pdfjs-assets.mjs",
    "verify:pdfjs": "node scripts/verify-pdfjs-assets.mjs",
    "verify:lockfile": "node scripts/verify-lockfile.mjs",
    "test": "vitest run",
    "test:bootstrap": "node scripts/test-core.mjs && npm run test:file-resource && npm run test:install-guard",
    "test:file-resource": "node scripts/test-file-resource.cjs",
    "test:install-guard": "node scripts/test-install-guard.mjs",
    "test:e2e": "playwright test",
    "test:electron": "node scripts/electron-smoke.mjs",
    "check": "npm run verify:install && npm run typecheck && npm run test && npm run build",
    "docs:filelist": "node scripts/generate-filelist.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.6.1",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "24.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "9.2.1",
    "cross-env": "10.0.0",
    "electron": "43.1.0",
    "playwright": "1.60.0",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.7",
    "wait-on": "9.0.1",
    "fake-indexeddb": "6.2.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
