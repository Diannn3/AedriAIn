{
  "name": "spatial-student-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Webcam hand-tracked spatial desktop shell for student productivity and UPLB modules.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "desktop": "electron .",
    "typecheck": "tsc -b --pretty false",
    "test:core": "bash scripts/test-core.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "wait-on": "^9.0.1"
  }
}
